{
  "name": "kriterium",
  "productName": "Критериум",
  "version": "1.0.0",
  "description": "Настольное приложение для глубокой оценки видеоигр по критериям",
  "main": "main.js",
  "author": "Личный профиль",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "seed": "node scripts/seed.js",
    "test:cloud": "node --test scripts/test-cloud.js",
    "dist": "electron-builder --win portable",
    "dist:dir": "electron-builder --win dir"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "ru.kriterium.app",
    "productName": "Критериум",
    "copyright": "Критериум",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "supabase/**/*",
      "README.md",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kriterium-${version}.exe"
    },
    "portable": {
      "artifactName": "Kriterium-${version}.exe"
    },
    "compression": "maximum"
  }
}
